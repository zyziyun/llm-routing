FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir \
    "fastapi>=0.110" "uvicorn[standard]>=0.29" "pydantic>=2" "pydantic-settings>=2" \
    "httpx>=0.27" "redis>=5" "prometheus-client>=0.20"

COPY src ./src
ENV PYTHONPATH=/app/src GW_ENV=prod
EXPOSE 8000

# Honors $PORT (Cloud Run / Render / Fly set it) and $WEB_CONCURRENCY.
# IMPORTANT: with the in-memory store, use WEB_CONCURRENCY=1 and a single
# instance so cache/breaker/budget stay consistent. With GW_REDIS_URL set,
# state is shared, so more workers and instances are safe.
CMD ["sh", "-c", "uvicorn gateway.app:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-4}"]

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/healthz').status==200 else 1)"
