# Copy to .env and edit to go live. Defaults (all "mock") run offline.

# Backend per tier: mock | ollama | openai
EDGE_BACKEND=mock
CHEAP_BACKEND=mock
FRONTIER_BACKEND=mock

# The one dial that sets the cost/quality tradeoff. Higher => more escalation.
CONFIDENCE_THRESHOLD=0.62

# Optional second-stage LLM-as-judge for non-schema tasks (needs FRONTIER live).
USE_LLM_JUDGE=0
LLM_JUDGE_THRESHOLD=0.6

# Cache: exact | embed
CACHE_MODE=exact

# --- EDGE via Ollama (on-device small model) ---
# EDGE_BACKEND=ollama
# EDGE_MODEL=llama3.2:3b        # or qwen3:4b, phi4-mini, gpt-oss:20b
# start the daemon first: `ollama serve` and `ollama pull llama3.2:3b`

# --- CHEAP / FRONTIER via any OpenAI-compatible API ---
# CHEAP_BACKEND=openai
# FRONTIER_BACKEND=openai
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an OpenRouter / vLLM / LiteLLM URL
# OPENAI_API_KEY=sk-...
# CHEAP_MODEL=gpt-4o-mini
# FRONTIER_MODEL=gpt-5

# Prices (USD per 1K tokens) drive the cost accounting. Update to your rates.
# EDGE_PRICE_PER_1K=0.0
# CHEAP_PRICE_PER_1K=0.0006
# FRONTIER_PRICE_PER_1K=0.01
